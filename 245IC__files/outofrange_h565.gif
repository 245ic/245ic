<style type="text/css">
#custom-personel .gdlr-core-personnel-list-content-wrap {
    display: flex;
    flex-direction: column;
}

#custom-personel .gdlr-core-personnel-list-content-wrap h3.gdlr-core-personnel-list-title{
  order: -2;
}

#custom-personel .gdlr-core-personnel-list-content-wrap div.gdlr-core-personnel-list-position{
  order: -3;
}

#custom-personel .gdlr-core-personnel-list-content-wrap .gdlr-core-personnel-list-content{
  order: -1;
}

#custom-personel .gdlr-core-personnel-list-content-wrap .gdlr-core-personnel-info{
  margin: 0px;
}

.kingster-page-title-event-link {
  display: none;
}


</style>
